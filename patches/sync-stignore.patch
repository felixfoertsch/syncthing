+// Invalidate makes the next Load re-read ignore files even when their mtimes
+// are unchanged, as can happen when a remote update preserves a timestamp.
+func (m *Matcher) Invalidate() {
+	m.mut.Lock()
+	defer m.mut.Unlock()
+	m.changeDetector.Reset()
+}
